---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsNeighbours } from '../../docs/nav.mjs';

/**
 * One route for every docs page. The markdown is generated from the app repo by
 * `scripts/sync-docs.mjs`, so this file only has to put the page together:
 * title and lede from the nav, headings for the table of contents, and the
 * neighbours for the footer.
 */
export async function getStaticPaths() {
	const docs = await getCollection('docs');
	return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { prev, next } = docsNeighbours(entry.id);
---

<DocsLayout
	title={entry.data.title}
	description={entry.data.description}
	group={entry.data.group}
	active={entry.id}
	headings={headings}
	prev={prev}
	next={next}
	source={entry.data.source}
>
	<Content />
</DocsLayout>
